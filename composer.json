{
    "name": "dd32/wpcli-cron-concurrent",
    "description": "Runs WordPress cron tasks concurrently via wp-cli.",
    "type": "wp-cli-package",
    "keywords": ["wp-cli", "cron", "concurrent"],
    "license": "MIT",
    "version": "1.0.1",
    "require": {
        "wp-cli/wp-cli": "^2.0"
    },
    "autoload": {
        "classmap": ["src/"],
        "files": ["cron-concurrent.php"]
    },
    "extra": {
        "commands": [
            "cron-concurrent",
            "cron-concurrent run"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
